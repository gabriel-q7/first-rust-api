# Banco de dados PostgreSQL
# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/first_rust_api

# Segredo para assinar os tokens JWT
# Em produção, use um valor longo e aleatório (ex: openssl rand -hex 64)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Duração do token JWT em segundos (86400 = 24 horas)
JWT_EXPIRES_IN=86400

# Endereço e porta do servidor
SERVER_ADDR=0.0.0.0:3000
